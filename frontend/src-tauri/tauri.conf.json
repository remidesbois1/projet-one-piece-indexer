{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poneglyph",
  "version": "1.0.0",
  "identifier": "fr.poneglyph.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "./desktop-fallback"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poneglyph",
        "url": "https://poneglyph.fr",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../public/ms-icon-310x310.ico"
    ],
    "resources": {
      "../../desktop_backend/": "desktop_backend/"
    },
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
