{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-privileged",
  "description": "Privileged desktop capability for bundled code and the local development server only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-local-model-status",
    "allow-get-local-text-model-status",
    "allow-get-local-surya-model-status",
    "allow-get-local-surya-bbox-model-status",
    "allow-load-local-model",
    "allow-load-local-text-model",
    "allow-load-local-surya-model",
    "allow-load-local-surya-bbox-model",
    "allow-download-local-model",
    "allow-download-local-text-model",
    "allow-download-local-surya-model",
    "allow-download-local-surya-bbox-model",
    "allow-run-local-ocr",
    "allow-run-local-text-ocr",
    "allow-run-local-surya-ocr",
    "allow-run-local-surya-bbox-ocr",
    "allow-healthcheck-local-backend",
    "allow-get-app-version"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000/**",
      "http://127.0.0.1:3000/**"
    ]
  }
}
