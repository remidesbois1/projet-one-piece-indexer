{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability - grants core permissions and local OCR commands to the main window and poneglyph.fr",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-local-model-status",
    "allow-get-local-text-model-status",
    "allow-load-local-model",
    "allow-load-local-text-model",
    "allow-download-local-model",
    "allow-download-local-text-model",
    "allow-run-local-ocr",
    "allow-run-local-text-ocr",
    "allow-healthcheck-local-backend",
    "allow-get-app-version"
  ],
  "remote": {
    "urls": ["https://poneglyph.fr/**", "https://www.poneglyph.fr/**"]
  }
}
