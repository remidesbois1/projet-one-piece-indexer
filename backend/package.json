{
  "name": "backend",
  "version": "1.0.0",
  "description": "API for Projet Poneglyph.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test",
    "test:api-contract": "node --test test/publicApiContract.test.js",
    "export:f2llm": "python scripts/export_f2llm_onnx.py --model-id ../scripts/embed/f2llm_v2_160m_finetuned_full --output models/f2llm-v2-160m-one-piece-retrieval",
    "export:f2llm:base": "python scripts/export_f2llm_onnx.py",
    "backfill:f2llm": "node scripts/backfill_f2llm_embeddings.js",
    "backfill:f2llm:force": "node scripts/backfill_f2llm_embeddings.js --force",
    "migrate:private-pages": "node scripts/migrate_pages_to_private_r2.js",
    "training:schema": "node scripts/apply_training_schema.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.993.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.75.0",
    "axios": "^1.13.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "mime-types": "^3.0.2",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "unzipper": "^0.12.3",
    "zod": "^4.4.3",
    "@poneglyph/shared": "*"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
