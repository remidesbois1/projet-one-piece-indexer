FROM node:22.14.0-bookworm-slim AS dependencies

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json

RUN npm ci \
    --workspace=backend \
    --workspace=@poneglyph/shared \
    --include=optional \
    --omit=dev \
    && npm install \
    --workspace=backend \
    --no-save \
    --include=optional \
    --omit=dev \
    --os=linux \
    --cpu=x64 \
    --libc=glibc \
    sharp@0.34.5 \
    && node -e "require('sharp'); console.log('sharp linux-x64 OK')"


FROM node:22.14.0-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

COPY --from=dependencies /app/node_modules ./node_modules

COPY package.json ./
COPY backend ./backend
COPY packages/shared ./packages/shared

EXPOSE 3001

CMD ["npm", "--workspace", "backend", "run", "start"]
